Create Security Groups module
Our project already contains:
modules/
├── vpc/
├── security/
├── alb/
├── ec2/
└── rds/
We will now work inside modules/security/.
Step 4.1: Create variables.tf
nano modules/security/variables.tf

variable "vpc_id" {
  description = "VPC ID where security groups will be created"
  type        = string
}

variable "project_name" {
  description = "Project name for resource tagging"
  type        = string
}

Create main.tf
nano modules/security/main.tf

# =========================================
# 1. ALB Security Group
# =========================================

resource "aws_security_group" "alb_sg" {

  name        = "${var.project_name}-alb-sg"
  description = "Allow HTTP traffic from internet"
  vpc_id      = var.vpc_id

  ingress {
    description = "Allow HTTP from internet"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    description = "Allow outbound traffic"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "${var.project_name}-alb-sg"
  }
}


# =========================================
# 2. Application Security Group
# =========================================

resource "aws_security_group" "app_sg" {

  name        = "${var.project_name}-app-sg"
  description = "Allow HTTP only from ALB"
  vpc_id      = var.vpc_id

  ingress {
    description     = "Allow HTTP from ALB"
    from_port       = 80
    to_port         = 80
    protocol        = "tcp"
    security_groups = [aws_security_group.alb_sg.id]
  }

  egress {
    description = "Allow outbound traffic"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "${var.project_name}-app-sg"
  }
}


# =========================================
# 3. Database Security Group
# =========================================

resource "aws_security_group" "db_sg" {

  name        = "${var.project_name}-db-sg"
  description = "Allow MySQL only from application servers"
  vpc_id      = var.vpc_id

  ingress {
    description     = "Allow MySQL from application servers"
    from_port       = 3306
    to_port         = 3306
    protocol        = "tcp"
    security_groups = [aws_security_group.app_sg.id]
  }

  egress {
    description = "Allow outbound traffic"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "${var.project_name}-db-sg"
  }
}

Create outputs.tf
Run:
nano modules/security/outputs.tf

Call the Security Groups module
Open the root main.tf:
nano main.tf

Your root main.tf should now contain both modules:

# =========================================
# VPC MODULE
# =========================================

module "vpc" {
  source = "./modules/vpc"

  project_name = var.project_name
  vpc_cidr     = var.vpc_cidr

  availability_zones = [
    "ap-south-1a",
    "ap-south-1b"
  ]
}


# =========================================
# SECURITY GROUP MODULE
# =========================================

module "security" {
  source = "./modules/security"

  vpc_id       = module.vpc.vpc_id
  project_name = var.project_name
}

