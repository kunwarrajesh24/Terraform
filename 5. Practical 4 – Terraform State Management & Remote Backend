Create provider.tf
nano provider.tf

terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}

provider "aws" {
  region = "ap-south-1"
}

Create main.tf
nano main.tf

Paste:

data "aws_ami" "ubuntu" {
  most_recent = true
  owners      = ["099720109477"]

  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-amd64-server-*"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}

resource "aws_instance" "state_demo" {
  ami           = data.aws_ami.ubuntu.id
  instance_type = "t3.micro"

  subnet_id = "subnet-0be15353ff9fc6eb3"

  tags = {
    Name      = "Terraform-State-Demo"
    ManagedBy = "Terraform"
  }
}

Initialize Terraform
terraform init
terraform fmt
terraform validate
terraform plan
terraform apply

Observe Terraform State
After successful creation, execute:
Command 1
ls -l

Command 2
terraform state list

Command 3
terraform state show aws_instance.state_demo

This displays detailed information about the EC2 instance recorded in Terraform state.

Command 4
cat terraform.tfstate

terraform plan

First state management command
Now execute:
terraform state list

Inspect the EC2 resource
Execute:
terraform state show aws_instance.state_demo

aws ec2 describe-instances \
  --region ap-south-1 \
  --filters "Name=tag:Name,Values=Terraform-State-Demo" \
  --query "Reservations[*].Instances[*].[InstanceId,InstanceType,State.Name,PrivateIpAddress,PublicIpAddress]" \
  --output table
